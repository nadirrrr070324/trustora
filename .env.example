NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose in frontend code:
# SUPABASE_SERVICE_ROLE_KEY=
# Demo mode: leave Supabase vars empty to run on the bundled demo dataset.
# See SUPABASE_SETUP.md for production migration path.

# Optional: enables Google Maps reverse geocoding for the "Near me" auto-location.
# When empty, the app falls back to OpenStreetMap Nominatim (keyless).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
